{
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ],
    "deny": [
      "Edit(.claude/agents/**)",
      "Edit(.claude/skills/**)",
      "Edit(.cursor/rules/**)",
      "Edit(CLAUDE.md)",
      "Edit(GEMINI.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/session_start.py"
          }
        ]
      }
    ]
  }
}
