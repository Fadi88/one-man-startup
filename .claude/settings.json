{
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(npm publish *)",
      "Bash(docker push *)",
      "Bash(vercel *)",
      "Bash(netlify deploy *)",
      "Bash(fly deploy *)",
      "Bash(firebase deploy *)",
      "Bash(supabase db push *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(gh pr merge *)"
    ],
    "deny": [
      "Edit(.claude/agents/**)",
      "Edit(.claude/skills/**)",
      "Edit(.cursor/rules/**)",
      "Edit(CLAUDE.md)",
      "Edit(GEMINI.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/session_start.py"
          }
        ]
      }
    ]
  }
}
